[user]
	name = Vishnu Hari
	email = 33627388+lycogno@users.noreply.github.com

[credential "https://github.com"]
	helper = !gh auth git-credential

[http]
	cookiefile = ~/.gitcookies

[alias]
	am = !git add --all && git commit --amend
	ci = !git add --all && git commit

[core]
	excludesFile = ~/dotfiles/global.gitignore

[init]
	defaultBranch = main
